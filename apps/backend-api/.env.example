PORT=4000
MONGODB_URI=mongodb://localhost:27017/ivisfit

# Better Auth — generá un secret de 32+ caracteres: openssl rand -base64 32
BETTER_AUTH_SECRET=
# URL pública donde el navegador llama a /api/auth (vía proxy del frontend en local)
BETTER_AUTH_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3000
# Orígenes CORS permitidos (separados por coma). Si no se define, se usan
# FRONTEND_URL + BETTER_AUTH_URL + TRUSTED_ORIGINS.
# CORS_ALLOWED_ORIGINS=http://localhost:3000,https://ivisfit.com,https://www.ivisfit.com
# TRUSTED_ORIGINS=https://ivisfit.com,https://www.ivisfit.com

# Resend (2FA y recuperación de contraseña por email)
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev
APP_NAME=IVIIS FIT
APP_URL=http://localhost:3000/alimentacion

# Web Push (notificaciones push de la app). Generá el par con:
#   node -e "console.log(JSON.stringify(require('web-push').generateVAPIDKeys()))"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ivis@ivisfit.com

# Scheduler de automatizaciones y recordatorios.
# En producción: SCHEDULER_ENABLED=true (si no, los emails de recordatorio no salen).
# Deshabilitado por defecto en local.
# SCHEDULER_ENABLED=false
# Tick del scheduler en ms (5 min por defecto).
# SCHEDULER_TICK_MS=300000

# Cloudinary (comprobantes de pago)
# Opción 1: pegá la API Environment variable completa del dashboard
CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name

# Opción 2: configurá las credenciales separadas
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Google AI Studio — chatbot asesor comercial (Gemini 2.5 Flash)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Timeout por request a Gemini (ms). 90000 = 90s.
GEMINI_REQUEST_TIMEOUT_MS=90000
# Reintentos ante errores transitorios (no se reintenta tras un timeout).
GEMINI_MAX_RETRIES=1

# WhatsApp comercial (código de país, sin +). Ej: 59898390351
WHATSAPP_PHONE=59898390351
# Link al grupo/comunidad de alumnas (opcional). Si no está, se deriva al WhatsApp de Ivis.
# WHATSAPP_COMMUNITY_URL=https://chat.whatsapp.com/...
