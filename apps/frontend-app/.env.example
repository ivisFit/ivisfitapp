# URL del backend (solo servidor / proxy). En local: http://localhost:4000
# El navegador SIEMPRE usa /api del mismo origen (no pongas esto en NEXT_PUBLIC_*
# o el CSP y las cookies rompen el panel tras el login).
API_URL=http://localhost:4000
# Opcional en local si querés apuntar el proxy sin rebuild: no se usa en el browser.
# NEXT_PUBLIC_API_URL=http://localhost:4000

# URL pública del frontend (Netlify/Vercel). Usada por auth y CMS.
NEXT_PUBLIC_FRONTEND_URL=http://localhost:3000

# WhatsApp comercial (código de país, sin +). Ej: 59898390351
NEXT_PUBLIC_WHATSAPP_PHONE=59898390351
# Link al grupo/comunidad de alumnas (opcional; el backend también puede definir WHATSAPP_COMMUNITY_URL)
# NEXT_PUBLIC_WHATSAPP_COMMUNITY_URL=https://chat.whatsapp.com/...

# CMS preview (site_content en MongoDB) — misma DB que backend-api
MONGODB_URI=mongodb://localhost:27017/ivisfit
BETTER_AUTH_SECRET=
# URL pública donde el navegador llama a /api/auth (mismo origen que el frontend)
BETTER_AUTH_URL=http://localhost:3000
UPLOADS_DIR=./uploads
CMS_UPLOAD_MAX_MB=5

# Producción con dominio propio (Render dashboard → ivisfit-api):
# FRONTEND_URL=https://ivisfit.com
# BETTER_AUTH_URL=https://ivisfit.com
# TRUSTED_ORIGINS=https://ivisfit.com,https://www.ivisfit.com

# WhatsApp de la profesora, con código de país y sin signos. Ej: 59899123456
NEXT_PUBLIC_PROFE_WHATSAPP_NUMBER=+59898390351
