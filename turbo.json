{
  "$schema": "https://turbo.build/schema.json",
  "envMode": "loose",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"],
      "env": [
        "API_URL",
        "NEXT_PUBLIC_API_URL",
        "FRONTEND_URL",
        "NEXT_PUBLIC_FRONTEND_URL",
        "BETTER_AUTH_SECRET",
        "BETTER_AUTH_URL",
        "MONGODB_URI",
        "MONGODB_DB_NAME",
        "TRUSTED_ORIGINS",
        "UPLOADS_DIR",
        "CMS_UPLOAD_MAX_MB",
        "NEXT_PUBLIC_WHATSAPP_PHONE",
        "NEXT_PUBLIC_WHATSAPP_COMMUNITY_URL",
        "NEXT_PUBLIC_PROFE_WHATSAPP_NUMBER",
        "NEXT_PUBLIC_EMAILJS_SERVICE_ID",
        "NEXT_PUBLIC_EMAILJS_TEMPLATE_ID",
        "NEXT_PUBLIC_EMAILJS_PUBLIC_KEY",
        "NEXT_PUBLIC_EMAILJS_TO_EMAIL"
      ]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "start": {
      "dependsOn": ["build"],
      "cache": false,
      "persistent": true
    }
  }
}
